{
    "root": true,
    "extends": ["react-app"],
    "ignorePatterns": [
        "node_modules/",
        "lib/",
        "storybook-static/",
        "bundle-check/",
        "demos/",
        "src/index.ts"
    ],
    "overrides": [
        {
            "files": [".storybook/**/*.{ts,tsx}"],
            "rules": {
                "import/no-webpack-loader-syntax": "off"
            }
        }
    ]
}
