{
    "name": "scichart-react",
    "version": "2.0.0",
    "description": "React wrapper for SciChart JS",
    "homepage": "https://www.scichart.com",
    "main": "./cjs/index.js",
    "module": "./esm/index.js",
    "types": "./types/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./types/index.d.ts",
                "default": "./esm/index.js"
            },
            "require": {
                "types": "./types/index.d.ts",
                "default": "./cjs/index.js"
            }
        },
        "./package.json": "./package.json",
        "./*": {
            "import": {
                "types": "./types/*.d.ts",
                "default": "./esm/*.js"
            },
            "require": {
                "types": "./types/*.d.ts",
                "default": "./cjs/*.js"
            }
        }
    },
    "scripts": {
        "build": "npm run generateGlobalExportsModule && npm run buildJs && npm run updateJson && npm run copyToLib && npm run verifyLib",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "storybook-docs": "storybook dev --docs",
        "build-storybook-docs": "storybook build --docs",
        "tsc": "tsc --watch",
        "typecheck": "tsc --noEmit",
        "relink": "cd lib && npm link",
        "buildJs": "rimraf lib && tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && tsc -p tsconfig.types.json",
        "generateGlobalExportsModule": "ts-node generate-exports-file.ts",
        "verifyLib": "ts-node scripts/verify-lib.ts && npm run verifyPackage",
        "verifyPackage": "publint lib && attw --pack lib --ignore-rules unexpected-module-syntax",
        "bundleCheck": "cd bundle-check && npm install --no-audit --no-fund && npm run measure",
        "updateJson": "run-script-os",
        "updateJson:nix": "cp package.json packageNpm.json && json -I -f packageNpm.json -e \"this.scripts={}\" -e \"this.devDependencies={}\"",
        "updateJson:windows": "copy package.json packageNpm.json && json -I -f packageNpm.json -e \"this.scripts={}\" -e \"this.devDependencies={}\"",
        "copyToLib": "copy-files-from-to --config copy-files-from-to.json",
        "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
        "prettier": "prettier src/**/*.{js,ts,tsx} --write",
        "pretty-quick": "pretty-quick --staged",
        "publishPublic": "npm version patch && npm run build && cd lib && npm publish",
        "publishAlpha": "npm version prerelease --preid=alpha && npm run build && cd lib && npm publish --tag alpha",
        "publishBeta": "npm version prerelease --preid=beta && npm run build && cd lib && npm publish --tag beta",
        "prepare": "husky install"
    },
    "author": "SciChart Ltd",
    "license": "MIT",
    "keywords": [
        "Chart",
        "Charts",
        "Data",
        "Graph",
        "Graphs",
        "Plot",
        "Plotting",
        "DataVisualization",
        "WebGL",
        "Realtime",
        "Webassembly",
        "Data",
        "Dataviz",
        "Dashboard",
        "Visualization",
        "3D",
        "Fast",
        "Fastest",
        "Best",
        "BigData",
        "Performance",
        "React"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/ABTSoftware/scichart-react"
    },
    "bugs": "https://github.com/ABTSoftware/scichart-react/issues",
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@babel/preset-env": "^7.23.3",
        "@babel/preset-react": "^7.23.3",
        "@babel/preset-typescript": "^7.23.3",
        "@storybook/addon-essentials": "^7.5.3",
        "@storybook/addon-interactions": "^7.5.3",
        "@storybook/addon-links": "^7.5.3",
        "@storybook/blocks": "^7.5.3",
        "@storybook/react": "^7.5.3",
        "@storybook/react-webpack5": "^7.5.3",
        "@storybook/testing-library": "^0.2.2",
        "@types/react": "^18.2.37",
        "copy-files-from-to": "^3.9.0",
        "copy-webpack-plugin": "^11.0.0",
        "eslint": "^8.57.0",
        "eslint-config-react-app": "^7.0.1",
        "husky": "^8.0.3",
        "json": "^11.0.0",
        "prettier": "^2.3.1",
        "pretty-quick": "^3.1.1",
        "publint": "^0.3.22",
        "raw-loader": "^4.0.2",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "rimraf": "^5.0.5",
        "run-script-os": "^1.1.6",
        "scichart": "6.0.1",
        "storybook": "^7.5.3",
        "ts-node": "^10.9.1",
        "typescript": "^5.2.2",
        "webpack": "^5.89.0",
        "webpack-cli": "^5.1.4",
        "webpack-merge": "^5.10.0"
    },
    "peerDependencies": {
        "react": ">=16.14.0",
        "scichart": ">=6.0.0-0"
    }
}
