{
    "name": "scichart-react",
    "version": "2.1.0",
    "description": "Official React component wrapper for SciChart.js. High-performance WebGL/WebGPU charts for real-time data streams and large datasets, with TypeScript support.",
    "homepage": "https://www.scichart.com/react-charts/",
    "main": "./cjs/index.js",
    "module": "./esm/index.js",
    "types": "./types/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./types/index.d.ts",
                "default": "./esm/index.js"
            },
            "require": {
                "types": "./types/index.d.ts",
                "default": "./cjs/index.js"
            }
        },
        "./package.json": "./package.json",
        "./*": {
            "import": {
                "types": "./types/*.d.ts",
                "default": "./esm/*.js"
            },
            "require": {
                "types": "./types/*.d.ts",
                "default": "./cjs/*.js"
            }
        }
    },
    "scripts": {
        "build": "npm run generateGlobalExportsModule && npm run buildJs && npm run updateJson && npm run copyToLib && npm run verifyLib",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "storybook-docs": "storybook dev --docs",
        "build-storybook-docs": "storybook build --docs",
        "tsc": "tsc --watch",
        "typecheck": "tsc --noEmit",
        "test:stories": "test-storybook --url http://127.0.0.1:6106",
        "test:stories:ci": "concurrently -k -s first -n \"SB,TEST\" \"npm run build-storybook -- --quiet && http-server storybook-static -a 127.0.0.1 --port 6106 --silent\" \"wait-on tcp:127.0.0.1:6106 && npm run test:stories\"",
        "test:e2e": "playwright test",
        "test:leak": "playwright test --project=app",
        "test:visual": "playwright test --project=stories",
        "test:docker": "docker build -t scichart-react-browser-tests -f tests/Dockerfile . && docker run --rm scichart-react-browser-tests",
        "relink": "cd lib && npm link",
        "buildJs": "rimraf lib && tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && tsc -p tsconfig.types.json",
        "generateGlobalExportsModule": "ts-node generate-exports-file.ts",
        "verifyLib": "ts-node scripts/verify-lib.ts && npm run verifyPackage",
        "verifyPackage": "publint lib && attw --pack lib --ignore-rules unexpected-module-syntax",
        "bundleCheck": "cd bundle-check && npm install --no-audit --no-fund && npm run measure",
        "updateJson": "run-script-os",
        "updateJson:nix": "cp package.json packageNpm.json && json -I -f packageNpm.json -e \"this.scripts={}\" -e \"this.devDependencies={}\"",
        "updateJson:windows": "copy package.json packageNpm.json && json -I -f packageNpm.json -e \"this.scripts={}\" -e \"this.devDependencies={}\"",
        "copyToLib": "copy-files-from-to --config copy-files-from-to.json",
        "lint": "eslint src .storybook --ext .js,.jsx,.ts,.tsx --max-warnings 0",
        "prettier": "prettier src/**/*.{js,ts,tsx} --write",
        "pretty-quick": "pretty-quick --staged",
        "release:latest": "gh workflow run publish.yaml --ref main",
        "release:alpha": "gh workflow run publish.yaml --ref alpha",
        "release:beta": "gh workflow run publish.yaml --ref beta",
        "prepare": "husky install",
        "update-snapshots": "playwright test --project=stories --update-snapshots"
    },
    "author": "SciChart Ltd",
    "license": "MIT",
    "keywords": [
        "scichart-react",
        "react",
        "react-charts",
        "react-chart",
        "react-chart-library",
        "react-graph",
        "react-component",
        "react-components",
        "scichart",
        "chart",
        "charts",
        "javascript-charts",
        "js-charts",
        "typescript",
        "webgl",
        "high-performance",
        "real-time",
        "streaming-data",
        "big-data",
        "fast",
        "data-visualization",
        "interactive-charts",
        "scientific-charts",
        "financial-charts",
        "candlestick-chart",
        "3d-charts",
        "webassembly",
        "webgpu",
        "graph",
        "plot",
        "dashboard",
        "nextjs"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/ABTSoftware/scichart-react"
    },
    "bugs": "https://github.com/ABTSoftware/scichart-react/issues",
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@babel/preset-env": "^7.23.3",
        "@babel/preset-react": "^7.23.3",
        "@babel/preset-typescript": "^7.23.3",
        "@playwright/test": "^1.63.0",
        "@storybook/addon-docs": "^10.6.0",
        "@storybook/addon-links": "^10.6.0",
        "@storybook/addon-webpack5-compiler-babel": "^4.0.1",
        "@storybook/react": "^10.6.0",
        "@storybook/react-webpack5": "^10.6.0",
        "@storybook/test-runner": "^0.24.5",
        "@types/react": "^18.3.0",
        "concurrently": "^10.0.5",
        "copy-files-from-to": "^3.9.0",
        "copy-webpack-plugin": "^11.0.0",
        "eslint": "^8.57.0",
        "eslint-config-react-app": "^7.0.1",
        "eslint-plugin-storybook": "10.6.0",
        "http-server": "^14.1.1",
        "husky": "^8.0.3",
        "json": "^11.0.0",
        "playwright": "^1.63.0",
        "prettier": "^2.3.1",
        "pretty-quick": "^3.1.1",
        "publint": "^0.3.22",
        "raw-loader": "^4.0.2",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "rimraf": "^5.0.5",
        "run-script-os": "^1.1.6",
        "scichart": "6.0.13",
        "storybook": "^10.6.0",
        "ts-node": "^10.9.1",
        "typescript": "^5.2.2",
        "wait-on": "^9.1.0",
        "webpack": "^5.89.0",
        "webpack-cli": "^5.1.4",
        "webpack-merge": "^5.10.0"
    },
    "peerDependencies": {
        "react": ">=16.14.0",
        "scichart": ">=6.0.13"
    }
}
